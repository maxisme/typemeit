{
  "$description": "Type Me It design tokens. Single source of truth; web/styles/theme.css and TypeMeIt/DesignTokens.swift are generated from this file by design/build-tokens.mjs. Edit here, then run `npm run tokens` in web/.",

  "color": {
    "$description": "One ink, one paper. rule is a grouping hairline and carries no meaning; rule-control is a control boundary and must reach 3:1 on paper. slab/on-slab is the inverted pair used for the primary action and the selected state.",
    "light": {
      "paper":        "#ffffff",
      "paper-sunk":   "#f7f7f7",
      "paper-raised": "#ffffff",
      "ink":          "#0a0a0a",
      "ink-2":        "#4a4a4a",
      "ink-3":        "#6e6e6e",
      "rule":         "#e4e4e4",
      "rule-control": "#949494",
      "slab":         "#0a0a0a",
      "on-slab":      "#ffffff",
      "ink-a04": "rgba(10, 10, 10, 0.04)",
      "ink-a08": "rgba(10, 10, 10, 0.08)",
      "ink-a12": "rgba(10, 10, 10, 0.12)",
      "ink-a20": "rgba(10, 10, 10, 0.20)",
      "ink-a32": "rgba(10, 10, 10, 0.32)",
      "ink-a48": "rgba(10, 10, 10, 0.48)",
      "ink-a64": "rgba(10, 10, 10, 0.64)",
      "ink-a88": "rgba(10, 10, 10, 0.88)"
    },
    "dark": {
      "paper":        "#0b0b0b",
      "paper-sunk":   "#060606",
      "paper-raised": "#161616",
      "ink":          "#fafafa",
      "ink-2":        "#b4b4b4",
      "ink-3":        "#8a8a8a",
      "rule":         "#262626",
      "rule-control": "#6e6e6e",
      "slab":         "#fafafa",
      "on-slab":      "#0b0b0b",
      "ink-a04": "rgba(250, 250, 250, 0.05)",
      "ink-a08": "rgba(250, 250, 250, 0.10)",
      "ink-a12": "rgba(250, 250, 250, 0.15)",
      "ink-a20": "rgba(250, 250, 250, 0.24)",
      "ink-a32": "rgba(250, 250, 250, 0.36)",
      "ink-a48": "rgba(250, 250, 250, 0.52)",
      "ink-a64": "rgba(250, 250, 250, 0.68)",
      "ink-a88": "rgba(250, 250, 250, 0.90)"
    }
  },

  "font": {
    "$description": "display and mono are the same face, DM Mono, so headings and measurements share one voice; ui is the platform face because the site documents a Mac app whose voice is SF. Text is set lowercase throughout.",
    "display": ["DM Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
    "ui":      ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Inter", "system-ui", "Segoe UI", "sans-serif"],
    "mono":    ["DM Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
    "swift": {
      "$description": "The Swift side uses Font.Design rather than a family list.",
      "display": "monospaced",
      "ui": "default",
      "mono": "monospaced"
    }
  },

  "text": {
    "$description": "size / lineHeight / tracking / weight. ui and label match the settings panel's 13pt and 11pt. Display sizes clamp and never pass 6rem. swiftSize is the fixed point size the app uses where the web clamps.",
    "display-1": { "size": "clamp(3rem, 8vw, 5.5rem)",     "swiftSize": 56, "lineHeight": 1.02, "tracking": "-0.028em", "weight": 400, "family": "display" },
    "display-2": { "size": "clamp(2.25rem, 5vw, 3.5rem)",  "swiftSize": 40, "lineHeight": 1.05, "tracking": "-0.024em", "weight": 400, "family": "display" },
    "display-3": { "size": "clamp(1.75rem, 3.5vw, 2.25rem)","swiftSize": 30, "lineHeight": 1.1,  "tracking": "-0.02em",  "weight": 400, "family": "display" },
    "title":     { "size": "1.375rem",  "swiftSize": 22, "lineHeight": 1.2,  "tracking": "-0.018em", "weight": 600, "family": "ui" },
    "heading":   { "size": "1.0625rem", "swiftSize": 17, "lineHeight": 1.3,  "tracking": "-0.012em", "weight": 600, "family": "ui" },
    "body":      { "size": "0.9375rem", "swiftSize": 15, "lineHeight": 1.55, "tracking": "-0.005em", "weight": 400, "family": "ui" },
    "ui":        { "size": "0.8125rem", "swiftSize": 13, "lineHeight": 1.35, "tracking": "0",        "weight": 400, "family": "ui" },
    "label":     { "size": "0.6875rem", "swiftSize": 11, "lineHeight": 1.3,  "tracking": "0.085em",  "weight": 600, "family": "ui" },
    "micro":     { "size": "0.625rem",  "swiftSize": 10, "lineHeight": 1.3,  "tracking": "0.01em",   "weight": 400, "family": "ui" }
  },

  "spacing": {
    "$description": "Base unit. Tailwind utilities multiply it, so p-12 is 12px — the same number as the SwiftUI .padding(12) it mirrors.",
    "unit": "1px",
    "scale": [2, 4, 6, 8, 9, 10, 12, 14, 16, 18, 20, 24, 32, 40, 56, 72, 96, 128]
  },

  "radius": {
    "$description": "lg is the macOS settings group. sm is a keycap. Every control lands on md so buttons, fields and selects share one curve.",
    "sm": "5px",
    "md": "7px",
    "lg": "10px",
    "full": "999px"
  },

  "hairline": "1px",

  "shadow": {
    "$description": "One shadow, for the recording pill only. Everything else is flat.",
    "lift": {
      "light": "0 10px 24px -6px rgba(10, 10, 10, 0.18), 0 2px 6px -2px rgba(10, 10, 10, 0.12)",
      "dark":  "0 10px 28px -6px rgba(0, 0, 0, 0.70), 0 2px 8px -2px rgba(0, 0, 0, 0.50)"
    }
  },

  "motion": {
    "ease": {
      "out":    "cubic-bezier(0.16, 1, 0.3, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "duration": {
      "1": "120ms",
      "2": "180ms",
      "3": "320ms",
      "4": "560ms"
    }
  },

  "focus": {
    "width": "2px",
    "offset": "2px"
  }
}
